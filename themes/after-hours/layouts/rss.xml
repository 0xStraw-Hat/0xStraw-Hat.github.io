{{- $pages := where .RegularPages "Section" "post" -}}
{{- if .IsHome -}}{{- $pages = where site.RegularPages "Section" "post" -}}{{- end -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>{{ site.Title }}{{ if not .IsHome }} · {{ .Title }}{{ end }}</title><link>{{ .Permalink }}</link><description>{{ site.Params.description }}</description><language>{{ site.Language.LanguageCode }}</language>{{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}{{ range first 30 $pages.ByDate.Reverse }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><guid>{{ .Permalink }}</guid><description>{{ .Description }}</description></item>{{ end }}</channel></rss>
